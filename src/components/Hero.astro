---
import { getImage } from 'astro:assets';
import bg from '../assets/pexels-fauxels-3184398-scaled.jpg';
import { hero } from '../data/content';

const bgImage = await getImage({ src: bg, width: 1920, format: 'webp' });
---

<section class="hero" style={`background-image: linear-gradient(rgb(0 32 178 / 0.8), rgb(0 32 178 / 0.8)), url(${bgImage.src})`}>
  <div class="container">
    <h1>{hero.title}</h1>
    <p class="lead">{hero.text}</p>
    <ul class="services">
      {hero.services.map((s) => <li>{s}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero {
    background-size: cover;
    background-position: center;
    color: #fff;
    text-align: center;
    padding-block: 110px;
  }
  h1 {
    color: #fff;
    font-size: clamp(2rem, 5vw, 3.4rem);
    max-width: 18ch;
    margin-inline: auto;
  }
  .lead {
    max-width: 62ch;
    margin: 0 auto 2.5rem;
    font-size: 1.15rem;
  }
  .services {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
  .services li {
    background: rgb(255 255 255 / 0.15);
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 999px;
    padding: 0.6rem 1.5rem;
    font-weight: 700;
  }
</style>
