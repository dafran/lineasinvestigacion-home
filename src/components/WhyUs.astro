---
import { Image } from 'astro:assets';
import { whyUs } from '../data/content';
---

<section id="por-que" class="section why">
  <div class="container">
    <h2 class="section-title">{whyUs.title}</h2>
    <div class="cards">
      {
        whyUs.items.map((item) => (
          <article class="card">
            <Image src={item.image} alt="" width={420} height={280} />
            <div class="body">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .why {
    background: var(--cream);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }
  .card {
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgb(0 0 0 / 0.07);
  }
  .card img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .body {
    padding: 1.25rem 1.5rem 1.5rem;
  }
  h3 {
    font-size: 1.2rem;
  }
  p {
    margin: 0;
  }
  @media (max-width: 980px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 620px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
