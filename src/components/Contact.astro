---
import { contact } from '../data/content';
---

<section id="contacto" class="section contact">
  <div class="container narrow">
    <h2 class="section-title">{contact.title}</h2>
    <p class="intro">{contact.text}</p>

    <form id="contact-form" action="/contact.php" method="post">
      <div class="row">
        <label>
          Nombre
          <input type="text" name="nombre" required maxlength="100" autocomplete="name" />
        </label>
        <label>
          Institución
          <input type="text" name="institucion" maxlength="150" autocomplete="organization" />
        </label>
      </div>
      <label>
        Correo electrónico
        <input type="email" name="email" required maxlength="150" autocomplete="email" />
      </label>
      <label>
        Mensaje
        <textarea name="mensaje" rows="5" required maxlength="3000"></textarea>
      </label>
      <!-- Honeypot anti-spam: los humanos no lo ven -->
      <div class="hp" aria-hidden="true">
        <label>No llenar <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <button class="btn" type="submit">Enviar solicitud</button>
      <p id="contact-status" role="status" aria-live="polite"></p>
    </form>

    <p class="alt">
      También puedes escribirnos a <a href={`mailto:${contact.email}`}>{contact.email}</a>
    </p>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button') as HTMLButtonElement;
    btn.disabled = true;
    if (status) status.textContent = 'Enviando…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      if (status) {
        status.className = 'ok';
        status.textContent = '¡Gracias! Recibimos tu solicitud y te responderemos pronto.';
      }
    } catch {
      if (status) {
        status.className = 'error';
        status.textContent = 'No pudimos enviar el mensaje. Escríbenos directamente al correo indicado abajo.';
      }
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .contact {
    background: #fff;
  }
  .narrow {
    max-width: 720px;
  }
  .intro {
    text-align: center;
    margin: -1.5rem 0 2rem;
  }
  form {
    display: grid;
    gap: 1rem;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  label {
    display: grid;
    gap: 0.35rem;
    font-weight: 500;
    color: var(--ink);
  }
  input,
  textarea {
    font: inherit;
    padding: 0.7rem 0.8rem;
    border: 1px solid #c9ccd1;
    border-radius: 4px;
    color: var(--ink);
  }
  input:focus,
  textarea:focus {
    outline: 2px solid var(--teal);
    outline-offset: 1px;
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  .btn {
    justify-self: start;
    border: 0;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  #contact-status {
    margin: 0;
    min-height: 1.5em;
  }
  #contact-status.ok {
    color: #0a7a42;
  }
  #contact-status.error {
    color: var(--accent);
  }
  .alt {
    text-align: center;
    margin-top: 2rem;
  }
  .alt a {
    color: var(--blue);
  }
  @media (max-width: 620px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
